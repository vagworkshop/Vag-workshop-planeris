# Nukopijuokite šį failą į ".env" (arba nustatykite tuos pačius kintamuosius
# jūsų talpinimo platformos "Environment Variables" nustatymuose).

# Būtina: bet koks ilgas atsitiktinis raktas, naudojamas prisijungimo sesijoms
# pasirašyti. Jei jo nenustatysite, serveris veiks, bet po kiekvieno
# perkrovimo visi turės prisijungti iš naujo.
JWT_SECRET=pakeiskite-i-ilga-atsitiktine-eilute

# Pasirinktina: pradiniai kiekvieno darbuotojo slaptažodžiai, sukuriami TIK
# pirmo paleidimo metu (jei vartotojo dar nėra duomenų bazėje). Jei
# nenustatysite, serveris sugeneruos atsitiktinį slaptažodį ir parodys jį
# vieną kartą serverio žurnale (logs) pirmo paleidimo metu.
ALANAS_PASSWORD=
SIGITAS_PASSWORD=
DARIUS_PASSWORD=

# Pasirinktina: kur laikyti duomenų failą (db.json). Render diegime tai turi
# rodyti į prijungto "Disk" aplanką, kad duomenys išliktų po perkrovimų.
# DATA_DIR=/var/data
